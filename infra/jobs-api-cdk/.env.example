# Existing resources used by JobsApiStack deploy/diff/synth
JOBS_TABLE_NAME=your-jobs-table
RESULT_BUCKET_NAME=your-results-bucket

# Optional: only for `npm run cdk:bootstrap`.
# If omitted, script uses current AWS credentials + configured default region.
# AWS_ACCOUNT_ID=123456789012
# AWS_REGION=us-east-1

# Optional: if empty, API returns presigned S3 URLs
RESULT_PUBLIC_BASE_URL=

# TTL for presigned links in seconds (60..86400)
PRESIGN_TTL_SECONDS=3600
